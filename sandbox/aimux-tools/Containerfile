# The aimux-tools runner image: the Wingman sandbox image plus gh, pinned by
# version and per-architecture SHA-256 (from gh_2.103.3_checksums.txt).
# aimux sandbox setup builds it as localhost/aimux-tools:2.103.3.
FROM localhost/wingman-sandbox:2.1.319
ARG TARGETARCH
ARG GH_VERSION=2.103.3
ARG GH_SHA256_ARM64=ee32df2323c8847f5fac6cb6b4b69ca75828e9329a8f22f677021f7b3306ce63
ARG GH_SHA256_AMD64=4c806978ffce1cec70853302a56d70ac6da4f19bae7adca4e1a8ab00633dd91d
RUN case "${TARGETARCH}" in \
      arm64) sum="${GH_SHA256_ARM64}" ;; \
      amd64) sum="${GH_SHA256_AMD64}" ;; \
      *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && d="gh_${GH_VERSION}_linux_${TARGETARCH}" \
 && curl -fsSL -o /tmp/gh.tgz "https://github.com/cli/cli/releases/download/v${GH_VERSION}/${d}.tar.gz" \
 && echo "${sum}  /tmp/gh.tgz" | sha256sum -c - \
 && tar -xzf /tmp/gh.tgz -C /tmp \
 && install -m 0755 "/tmp/${d}/bin/gh" /usr/bin/gh \
 && rm -rf /tmp/gh.tgz "/tmp/${d}"
