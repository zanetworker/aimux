{
  "name": "Repository paths with a slash and an extension become reference spans, with an optional line",
  "cases": [
    {
      "name": "relative path and relative path with a line",
      "context": {
        "repo": {
          "web": "https://github.com/acme/widget",
          "branch": "main",
          "root": "/Users/dev/code/widget"
        },
        "jiraBase": "https://jira.example.com",
        "jiraProjects": [
          "WID",
          "OPS"
        ],
        "project": "/Users/dev/code/widget"
      },
      "inlines": [
        {
          "t": "text",
          "v": "Edit internal/api/server.go and internal/api/server.go:42 now."
        }
      ],
      "expect": [
        {
          "t": "text",
          "v": "Edit "
        },
        {
          "t": "ref",
          "kind": "path",
          "v": "internal/api/server.go",
          "href": "https://github.com/acme/widget/blob/main/internal/api/server.go"
        },
        {
          "t": "text",
          "v": " and "
        },
        {
          "t": "ref",
          "kind": "path",
          "v": "internal/api/server.go:42",
          "href": "https://github.com/acme/widget/blob/main/internal/api/server.go#L42"
        },
        {
          "t": "text",
          "v": " now."
        }
      ]
    },
    {
      "name": "leading ./ is dropped; dot directories work",
      "context": {
        "repo": {
          "web": "https://github.com/acme/widget",
          "branch": "main",
          "root": "/Users/dev/code/widget"
        },
        "jiraBase": "https://jira.example.com",
        "jiraProjects": [
          "WID",
          "OPS"
        ],
        "project": "/Users/dev/code/widget"
      },
      "inlines": [
        {
          "t": "text",
          "v": "See ./cmd/main.go and .github/workflows/ci.yml:7."
        }
      ],
      "expect": [
        {
          "t": "text",
          "v": "See "
        },
        {
          "t": "ref",
          "kind": "path",
          "v": "./cmd/main.go",
          "href": "https://github.com/acme/widget/blob/main/cmd/main.go"
        },
        {
          "t": "text",
          "v": " and "
        },
        {
          "t": "ref",
          "kind": "path",
          "v": ".github/workflows/ci.yml:7",
          "href": "https://github.com/acme/widget/blob/main/.github/workflows/ci.yml#L7"
        },
        {
          "t": "text",
          "v": "."
        }
      ]
    },
    {
      "name": "a sentence period after the path is not part of it",
      "context": {
        "repo": {
          "web": "https://github.com/acme/widget",
          "branch": "main",
          "root": "/Users/dev/code/widget"
        },
        "jiraBase": "https://jira.example.com",
        "jiraProjects": [
          "WID",
          "OPS"
        ],
        "project": "/Users/dev/code/widget"
      },
      "inlines": [
        {
          "t": "text",
          "v": "The bug is in src/cache/ttl.go. Also src/a.go, src/b.go; and (src/c.go)."
        }
      ],
      "expect": [
        {
          "t": "text",
          "v": "The bug is in "
        },
        {
          "t": "ref",
          "kind": "path",
          "v": "src/cache/ttl.go",
          "href": "https://github.com/acme/widget/blob/main/src/cache/ttl.go"
        },
        {
          "t": "text",
          "v": ". Also "
        },
        {
          "t": "ref",
          "kind": "path",
          "v": "src/a.go",
          "href": "https://github.com/acme/widget/blob/main/src/a.go"
        },
        {
          "t": "text",
          "v": ", "
        },
        {
          "t": "ref",
          "kind": "path",
          "v": "src/b.go",
          "href": "https://github.com/acme/widget/blob/main/src/b.go"
        },
        {
          "t": "text",
          "v": "; and ("
        },
        {
          "t": "ref",
          "kind": "path",
          "v": "src/c.go",
          "href": "https://github.com/acme/widget/blob/main/src/c.go"
        },
        {
          "t": "text",
          "v": ")."
        }
      ]
    },
    {
      "name": "inline code that is exactly a path",
      "context": {
        "repo": {
          "web": "https://github.com/acme/widget",
          "branch": "main",
          "root": "/Users/dev/code/widget"
        },
        "jiraBase": "https://jira.example.com",
