        {
          "t": "code",
          "v": "internal/api/server.go"
        },
        {
          "t": "text",
          "v": " or "
        },
        {
          "t": "code",
          "v": "internal/api/server.go:42"
        },
        {
          "t": "text",
          "v": "."
        }
      ],
      "expect": [
        {
          "t": "text",
          "v": "Open "
        },
        {
          "t": "ref",
          "kind": "path",
          "v": "internal/api/server.go",
          "href": "https://github.com/acme/widget/blob/main/internal/api/server.go",
          "code": true
        },
        {
          "t": "text",
          "v": " or "
        },
        {
          "t": "ref",
          "kind": "path",
          "v": "internal/api/server.go:42",
          "href": "https://github.com/acme/widget/blob/main/internal/api/server.go#L42",
          "code": true
        },
        {
          "t": "text",
          "v": "."
        }
      ]
    },
    {
      "name": "inline code that is more than a path stays code",
      "context": {
        "repo": {
          "web": "https://github.com/acme/widget",
          "branch": "main",
