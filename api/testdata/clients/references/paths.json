        {
          "t": "text",
          "v": " "
        },
        {
          "t": "code",
          "v": " internal/api/server.go"
        }
      ],
      "expect": [
        {
          "t": "code",
          "v": "go test internal/api/server.go"
        },
        {
          "t": "text",
          "v": " "
        },
        {
          "t": "code",
          "v": "cat internal/api/server.go | head"
        },
        {
          "t": "text",
          "v": " "
        },
        {
          "t": "code",
          "v": " internal/api/server.go"
        }
      ]
    },
