<mxfile host="paperdiagram"><diagram name="Page-1"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Three plans, each shippable on its own: profiles and one contract first, then the tool gateway, then research with context" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1160" height="20" as="geometry"/></mxCell><mxCell id="c2" value="Plan 1: profiles and one contract (this plan)" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=3;fillColor=none;strokeColor=#2F6FCF;dashed=1;strokeWidth=1.5;fontStyle=1;fontColor=#1F4E9E;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;strokeColor=#D99A1E;fontColor=#8A5A00;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="375" height="470" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Per-tool pins, live check&lt;/b&gt;&lt;br&gt;&lt;i&gt;closes the readonly.go:101 gap&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="92" width="343" height="68" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Profiles v2 + CLI&lt;/b&gt;&lt;br&gt;&lt;i&gt;manifest, narrow-only, digest&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="176" width="343" height="68" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Compiler + launcher&lt;/b&gt;&lt;br&gt;&lt;i&gt;policy with MCP t