<mxfile host="paperdiagram"><diagram name="Page-1"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Reference architecture for any agent: aimux decides, OpenShell enforces at the network, tools sit behind both" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1160" height="20" as="geometry"/></mxCell><mxCell id="c2" value="aimux on the host: decide and serve" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=3;fillColor=none;strokeColor=#2F6FCF;dashed=1;strokeWidth=1.5;fontStyle=1;fontColor=#1F4E9E;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;strokeColor=#D99A1E;fontColor=#8A5A00;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="340" height="420" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Registry + review&lt;/b&gt;&lt;br&gt;&lt;i&gt;you approve each read-only set;&#10;hints only suggest&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="92" width="308" height="62" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Profile compiler&lt;/b&gt;&lt;br&gt;&lt;i&gt;profile → policy, providers, MCP and&#10;GraphQL rules; digest per run&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="170" width="308" height="62" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Research runner&lt;/b&gt;&lt;br&gt;&lt;i&gt;planner, reader, writer;&#10;query check before any search&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="248" width="308" height="62" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Tool gateway (MCP proxy)&lt;/b&gt;&lt;br&gt;&lt;i&gt;stdio servers and tool credentials;&#10;catalog filter, so the model sees only&#10;reviewed tools; pins on tools/list;&#10;CLI argument allowlist&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FBE3E1;strokeColor=#D2453E;" vertex="1" parent="1"><mxGeometry x="36" y="326" width="308" height="98" as="geometry"/></mxCell><mxCell id="c7" value="OpenShell: enforce" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=3;fillColor=none;strokeColor=#5A6270;dashed=1;dashPattern=8 4;strokeWidth=2;fontStyle=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;strokeColor=#D2453E;fontColor=#A3271F;" vertex="1" parent="1"><mxGeometry x="400" y="56" width="440" height="420" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;&lt;i&gt;sandboxes, policies,&#10;providers&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="416" y="92" width="200" height="62" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Interceptor (optional)&lt;/b&gt;&lt;br&gt;&lt;i&gt;rejects policy that&#10;weakens the profile&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="630" y="92" width="194" height="62" as="geometry"/></mxCell><mxCell id="c10" value="sandbox" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontStyle=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="416" y="172" width="408" height="288" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Agent harness&lt;/b&gt;&lt;br&gt;&lt;i&gt;Claude Code, a Wingman lane, any agent;&#10;exact --tools, no user settings or hooks&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="432" y="204" width="376" height="62" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Supervisor proxy&lt;/b&gt;&lt;br&gt;&lt;i&gt;default deny, binary scoping, credential injection;&#10;L7: REST, GraphQL, MCP method + tool name;&#10;OCSF audit of every call&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FBE3E1;strokeColor=#D2453E;" vertex="1" parent="1"><mxGeometry x="432" y="280" width="376" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Middleware (optional, later)&lt;/b&gt;&lt;br&gt;&lt;i&gt;inspect or rewrite bodies and responses&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="432" y="384" width="376" height="58" as="geometry"/></mxCell><mxCell id="c14" value="outside" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontStyle=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="880" y="56" width="300" height="420" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Model API&lt;/b&gt;&lt;br&gt;&lt;i&gt;token injected by a provider;&#10;the agent sees a placeholder&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="896" y="92" width="268" height="62" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Web&lt;/b&gt;&lt;br&gt;&lt;i&gt;research profile only;&#10;GET, audited&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="896" y="200" width="268" height="62" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Tools&lt;/b&gt;&lt;br&gt;&lt;i&gt;Slack, Jira, wiki, Gmail,&#10;gh, kubectl, HTTP APIs&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="896" y="372" width="268" height="70" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;fontFamily=Comic Sans MS;fontStyle=2;fontColor=#5