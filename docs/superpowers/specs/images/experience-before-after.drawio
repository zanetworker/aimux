<mxfile host="paperdiagram"><diagram name="Page-1"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="What changes for you: the same profiles, runs and history on every surface; Wingman stays a small panel" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1180" height="20" as="geometry"/></mxCell><mxCell id="c2" value="Surface" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="36" y="50" width="170" height="20" as="geometry"/></mxCell><mxCell id="c3" value="Today" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="50" width="460" height="20" as="geometry"/></mxCell><mxCell id="c4" value="After" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="50" width="460" height="20" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Wingman panel&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="76" width="170" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Page, or Work with my tools&lt;/b&gt;&lt;br&gt;&lt;i&gt;research and context are separate asks&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="220" y="76" width="470" height="50" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Research by default, one "Use my context" toggle&lt;/b&gt;&lt;br&gt;&lt;i&gt;one ask, a progress line, sources from both&lt;/i&gt;' style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="720" y="76" width="470" height="50" as="geometry"/></mxCell><mxCell id="c8" value="" style="html=1;fontFamily=Comic Sans MS;fontStyle=2;fontColor=#555555;fontSize=10;labelBackgroundColor=none;align=left;endArrow=block;endSize=5;endFill=1;strokeColor=#2B4A7A;strokeWidth=1.5;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="101" as="sourcePoint"/><mxPoint x="720" y="101" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;Privacy check&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="136" width="170" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;None needed: Work never reaches the web&lt;/b&gt;&lt;br&gt;&lt;i&gt;and Research never sees your tools&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="220" y="136" width="470" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Query check, rarely&lt;/b&gt;&lt;br&gt;&lt;i&gt;asks only when a search would name a person, ticket or secret&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="720" y="136" width="470" height="50" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;fontFamily=Comic Sans MS;fontStyle=2;fontColor=#555555;fontSize=10;labelBackgroundColor=none;align=left;endArrow=block;endSize=5;endFill=1;strokeColor=#2B4A7A;strokeWidth=1.5;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="161" as="sourcePoint"/><mxPoint x="720" y="161" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;Adding a tool&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="196" width="170" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Edit readonly.json by hand&lt;/b&gt;&lt;br&gt;&lt;i&gt;tool names only, no change detection&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="220" y="196" width="470" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;aimux tools add, then review once&lt;/b&gt;&lt;br&gt;&lt;i&gt;a tool that changes hides until reviewed again&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="720" y="196" width="470" height="50" as="geometry"/></mxCell><mxCell id="c16" value="" style="html=1;fontFamily=Comic Sans MS;fontStyle=2;fontColor=#555555;fontSize=10;labelBackgroundColor=none;align=left;endArrow=block;endSize=5;endFill=1;strokeColor=#2B4A7A;strokeWidth=1.5;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="221" as="sourcePoint"/><mxPoint x="720" y="221" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Phone and dashboard&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="256" width="170" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Wingman questions are invisible there&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="220" y="256" width="470" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Each Wingman run shows up as one run&lt;/b&gt;&lt;br&gt;&lt;i&gt;with its profile; continue it on the phone&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="720" y="256" width="470" height="50" as="geometry"/></mxCell><mxCell id="c20" value="" style="html=1;fontFamily=Comic Sans MS;fontStyle=2;fontColor=#555555;fontSize=10;labelBackgroundColor=none;align=left;endArrow=block;endSize=5;endFill=1;strokeColor=#2B4A7A;strokeWidth=1.5;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="281" as="sourcePoint"/><mxPoint x="720" y="281" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Past sessions&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="316" width="170" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Work-lane transcripts die with the sandbox&lt;/b&gt;&lt;br&gt;&lt;i&gt;Wingman cannot look back&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="220" y="316" width="470" height="50" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b&gt;All runs archived and searchable&lt;/b&gt;&lt;br&gt;&lt;i&gt;optional "sessions" source, with the query preview&lt;/i&gt;' style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="720" y="316" width="470" height="50" as="geometry"/></mxCell><mxCell id="c24" value="" style="html=1;fontFamily=Comic Sans MS;fontStyle=2;fontColor=#555555;fontSize=10;labelBackgroundColor=none;align=left;endArrow=block;endSize=5;endFill=1;strokeColor=#2B4A7A;strokeWidth=1.5;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="341" as="sourcePoint"/><mxPoint x="720" y="341" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;Terminal and cron&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="376" width="170" height="50" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Profiles are saved flags&lt;/b&gt;&lt;br&gt;&lt;i&gt;no sandboxed read-only agent outside Wingman&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="220" y="376" width="470" height="50" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;aimux run, spawn, schedule --profile&lt;/b&gt;&lt;br&gt;&lt;i&gt;the same research or work-readonly agent&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="720" y="376" width="470" height="50" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;fontFamily=Comic Sans MS;fontStyle=2;fontColor=#555555;fontSize=10;labelBackgroundColor=none;align=left;endArrow=block;endSize=5;endFill=1;strokeColor=#2B4A7A;strokeWidth=1.5;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="401" as="sourcePoint"/><mxPoint x="720" y="401" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Safety&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="436" width="170" height="50" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Wingman cannot post&lt;/b&gt;&lt;br&gt;&lt;i&gt;tool names checked once, by aimux&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="220" y="436" width="470" height="50" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Still cannot post&lt;/b&gt;&lt;br&gt;&lt;i&gt;names checked by aimux and the network; no coding sessions from Wingman&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="720" y="436" width="470" height="50" as="geometry"/></mxCell><mxCell id="c32" value="" style="html=1;fontFamily=Comic Sans MS;fontStyle=2;fontColor=#555555;fontSize=10;labelBackgroundColor=none;align=left;endArrow=block;endSize=5;endFill=1;strokeColor=#2B4A7A;strokeWidth=1.5;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="461" as="sourcePoint"/><mxPoint x="720" y="461" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="20" y="502" width="22" height="12" as="geometry"/></mxCell><mxCell id="c34" value="today" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="48" y="500" width="35" height="16" as="geometry"/></mxCell><mxCell id="c35" value="" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="101" y="502" width="22" height="12" as="geometry"/></mxCell><mxCell id="c36" value="after the change" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="129" y="500" width="112" height="16" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
