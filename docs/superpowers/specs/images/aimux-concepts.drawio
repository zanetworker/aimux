<mxfile host="paperdiagram"><diagram name="Page-1"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='Where aimux goes: from "watch and spawn my agents" to "run agents safely from any client". Most concepts exist; four are new' style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1180" height="20" as="geometry"/></mxCell><mxCell id="c2" value="Reused as is" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontStyle=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="380" height="520" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Sessions&lt;/b&gt;&lt;br&gt;&lt;i&gt;history, catalog, sessionstate, search:&#10;every surface already reads these&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="92" width="348" height="64" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;acprun&lt;/b&gt;&lt;br&gt;&lt;i&gt;continue a session over ACP; the remote&#10;API broker and Wingman's Page lane both use it&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="170" width="348" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Environments + runtimes&lt;/b&gt;&lt;br&gt;&lt;i&gt;local, container, k8s, OpenShell;&#10;CreateSandbox, PolicyEnforcer interfaces&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="248" width="348" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;remote API v1&lt;/b&gt;&lt;br&gt;&lt;i&gt;contract, fixtures, tailnet auth, pairing,&#10;events, approvals, queue&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="326" width="348" height="64" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;controller&lt;/b&gt;&lt;br&gt;&lt;i&gt;UI-agnostic logic for TUI and web&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="404" width="348" height="64" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;trace, cost, otel, deliver&lt;/b&gt;&lt;br&gt;&lt;i&gt;observability and output targets&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="482" width="348" height="64" as="geometry"/></mxCell><mxCell id="c9" value="Extended (same name, more meaning)" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=3;fillColor=none;strokeColor=#2F6FCF;dashed=1;strokeWidth=1.5;fontStyle=1;fontColor=#1F4E9E;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="420" y="56" width="380" height="520" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Profile&lt;/b&gt;&lt;br&gt;&lt;i&gt;today: saved flags (provider, dir, model, mode)&#10;after: security contract, narrow-only, digest&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="436" y="92" width="348" height="76" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Spawn&lt;/b&gt;&lt;br&gt;&lt;i&gt;today: --environment openshell exists&#10;after: --profile picks sandbox, tools, policy&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="436" y="184" width="348" height="76" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;MCP proxy → tool gateway&lt;/b&gt;&lt;br&gt;&lt;i&gt;today: allowlist by name, readonly listener&#10;after: any tool kind, review, pins, MCP rules&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="436" y="276" width="348" height="76" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;remote API v1&lt;/b&gt;&lt;br&gt;&lt;i&gt;after: + profiles, + runs, + per-client scopes;&#10;also served on a local Unix socket&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="436" y="368" width="348" height="76" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;OpenShell launch&lt;/b&gt;&lt;br&gt;&lt;i&gt;today: three code paths (compose, environment,&#10;Wingman); after: one compiler + launcher&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="436" y="460" width="348" height="76" as="geometry"/></mxCell><mxCell id="c15" value="New concepts" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=3;fillColor=none;strokeColor=#2F6FCF;dashed=1;strokeWidth=1.5;fontStyle=1;fontColor=#1F4E9E;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;strokeColor=#D99A1E;fontColor=#8A5A00;" vertex="1" parent="1"><mxGeometry x="820" y="56" width="380" height="520" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Run&lt;/b&gt;&lt;br&gt;&lt;i&gt;one request that owns several sessions with&#10;roles and data rules (planner, reader, writer)&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FBE3E1;strokeColor=#D2453E;" vertex="1" parent="1"><mxGeometry x="836" y="92" width="348" height="78" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Reviewed tool set + pin&lt;/b&gt;&lt;br&gt;&lt;i&gt;a human-approved read-only set per source;&#10;change hides the tool&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="836" y="188" width="348" height="78" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Client scope&lt;/b&gt;&lt;br&gt;&lt;i&gt;which profiles a client may use:&#10;Wingman never gets coding&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="836" y="284" width="348" height="78" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Query check&lt;/b&gt;&lt;br&gt;&lt;i&gt;the one place private text may leave,&#10;checked before any search&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="836" y="380" width="348" height="78" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Retired&lt;/b&gt;&lt;br&gt;&lt;i&gt;Wingman's own broker, history.db,&#10;readonly.json, hand-rolled sandbox exec&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="836" y="486" width="348" height="70" as="geometry"/></mxCell><mxCell id="c21" value="" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="20" y="598" width="22" height="12" as="geometry"/></mxCell><mxCell id="c22" value="grows" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="48" y="596" width="35" height="16" as="geometry"/></mxCell><mxCell id="c23" value="" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;shadow=0;fillColor=#FFF6E0;strokeColor=#D99A1E;" vertex="1" parent="1"><mxGeometry x="101" y="598" width="22" height="12" as="geometry"/></mxCell><mxCell id="c24" value="new" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="129" y="596" width="21" height="16" as="geometry"/></mxCell><mxCell id="c25" value="" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="168" y="598" width="22" height="12" as="geometry"/></mxCell><mxCell id="c26" value="goes away" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="196" y="596" width="63" height="16" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
