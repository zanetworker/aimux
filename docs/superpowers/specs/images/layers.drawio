<mxfile host="paperdiagram"><diagram name="Page-1"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="OpenShell enforces at the sandbox and the network, down to MCP tool names; aimux adds arguments, pins, review and which data each model call sees" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1100" height="20" as="geometry"/></mxCell><mxCell id="c2" value="aimux adds (tool, argument and data level)" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=3;fillColor=none;strokeColor=#2F6FCF;dashed=1;strokeWidth=1.5;fontStyle=1;fontColor=#1F4E9E;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;strokeColor=#D99A1E;fontColor=#8A5A00;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1100" height="210" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;📇 Tool registry + review&lt;/b&gt;&lt;br&gt;&lt;i&gt;source identity, reviewed&#10;read-only sets, curated CLI packs&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="92" width="256" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;📌 Per-tool pins&lt;/b&gt;&lt;br&gt;&lt;i&gt;schema, flags, method; checked&#10;live; drift hides the tool&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="306" y="92" width="256" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;🔀 MCP catalog filter&lt;/b&gt;&lt;br&gt;&lt;i&gt;stdio servers too; same list&#10;as the compiled MCP rules&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="576" y="92" width="256" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;⌨️ CLI argument allowlist&lt;/b&gt;&lt;br&gt;&lt;i&gt;gh issue view yes,&#10;gh pr merge no; no shell&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="846" y="92" width="258" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;🧾 Profiles&lt;/b&gt;&lt;br&gt;&lt;i&gt;contract, narrow-only inheritance,&#10;digest on every run&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="176" width="256" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;🔒 Harness lockdown&lt;/b&gt;&lt;br&gt;&lt;i&gt;--tools exact names, no user&#10;settings, hooks or MCP&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="306" y="176" width="256" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;🧭 Three-call research&lt;/b&gt;&lt;br&gt;&lt;i&gt;planner, reader, writer;&#10;who sees what&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="576" y="176" width="256" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;🔍 Query check&lt;/b&gt;&lt;br&gt;&lt;i&gt;private terms in searches:&#10;ask, strip or fall back&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="846" y="176" width="258" height="70" as="geometry"/></mxCell><mxCell id="c11" value="compiled into ↓ by the profile compiler" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="470" y="278" width="300" height="20" as="geometry"/></mxCell><mxCell id="c12" value="OpenShell provides (sandbox and network level)" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=3;fillColor=none;strokeColor=#5A6270;dashed=1;dashPattern=8 4;strokeWidth=2;fontStyle=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;strokeColor=#D2453E;fontColor=#A3271F;" vertex="1" parent="1"><mxGeometry x="20" y="306" width="1100" height="300" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;📦 Sandbox isolation&lt;/b&gt;&lt;br&gt;&lt;i&gt;process, Landlock file rules,&#10;own image per sandbox&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="342" width="256" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;🚧 Default-deny egress&lt;/b&gt;&lt;br&gt;&lt;i&gt;allowed hosts and ports only;&#10;private IPs only if listed&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="306" y="342" width="256" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;🛂 L7 rules (REST, GraphQL, MCP)&lt;/b&gt;&lt;br&gt;&lt;i&gt;method+path; query vs mutation;&#10;MCP method + tool name per path&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="576" y="342" width="256" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;🎯 Binary scoping&lt;/b&gt;&lt;br&gt;&lt;i&gt;only this binary may&#10;reach that host&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="846" y="342" width="258" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;🔑 Credential injection&lt;/b&gt;&lt;br&gt;&lt;i&gt;providers; the sandbox&#10;only sees a placeholder&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="426" width="256" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;🚦 Live policy reload&lt;/b&gt;&lt;br&gt;&lt;i&gt;policy set --wait; open&#10;tunnels closed on change&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="306" y="426" width="256" height="70" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;🧾 Audit (OCSF)&lt;/b&gt;&lt;br&gt;&lt;i&gt;every connection; MCP calls&#10;logged with the tool name&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="576" y="426" width="256" height="70" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;🙈 Cannot see&lt;/b&gt;&lt;br&gt;&lt;i&gt;tool arguments, server responses&#10;(tools/list drift), data meaning&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="846" y="426" width="258" height="70" as="geometry"/></mxCell><mxCell id="c21" value="extension points (gRPC services aimux can register)" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="508" width="400" height="20" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Supervisor middleware&lt;/b&gt;&lt;br&gt;&lt;i&gt;inspect or rewrite request and&#10;response bodies; later, not v1&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="530" width="256" height="58" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Gateway interceptor&lt;/b&gt;&lt;br&gt;&lt;i&gt;reject policy changes that&#10;weaken the profile digest&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="306" y="530" width="256" height="58" as="geometry"/></mxCell><mxCell id="c24" value="" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;shadow=0;fillColor=#FFF6E0;strokeColor=#D99A1E;" vertex="1" parent="1"><mxGeometry x="20" y="628" width="22" height="12" as="geometry"/></mxCell><mxCell id="c25" value="aimux layer" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="48" y="626" width="77" height="16" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=none;dashed=1;dashPattern=8 4;strokeColor=#5A6270;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="143" y="634" as="sourcePoint"/><mxPoint x="179" y="634" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="OpenShell layer" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="185" y="626" width="105" height="16" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="308" y="628" width="22" height="12" as="geometry"/></mxCell><mxCell id="c29" value="gap aimux fills, or optional extension" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="336" y="626" width="266" height="16" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
