<mxfile host="paperdiagram"><diagram name="Page-1"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="aimux tool gateway: every kind of tool is registered once, reviewed once, pinned, and granted to agents only through profiles" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1100" height="20" as="geometry"/></mxCell><mxCell id="c2" value="tool sources" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#8C8C8C;fontStyle=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="230" height="340" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;🔌 MCP servers&lt;/b&gt;&lt;br&gt;&lt;i&gt;Slack, Jira, Gmail, notes&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="90" width="198" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;⌨️ CLI tools&lt;/b&gt;&lt;br&gt;&lt;i&gt;gh, kubectl, jira, oc&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="160" width="198" height="56" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;🌐 HTTP APIs&lt;/b&gt;&lt;br&gt;&lt;i&gt;REST or OpenAPI&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="230" width="198" height="56" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;🧰 Agent built-ins&lt;/b&gt;&lt;br&gt;&lt;i&gt;web search, read files&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="36" y="300" width="198" height="56" as="geometry"/></mxCell><mxCell id="c7" value="tool gateway (aimux)" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=3;fillColor=none;strokeColor=#2F6FCF;dashed=1;strokeWidth=1.5;fontStyle=1;fontColor=#1F4E9E;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="290" y="56" width="300" height="340" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;📇 Registry&lt;/b&gt;&lt;br&gt;&lt;i&gt;each source pinned to its identity:&#10;path + version, endpoint, package&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="306" y="90" width="268" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;✅ Review once per source&lt;/b&gt;&lt;br&gt;&lt;i&gt;hints and curated packs suggest;&#10;you approve the reviewed read set&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFF6E0;strokeColor=#D99A1E;" vertex="1" parent="1"><mxGeometry x="306" y="166" width="268" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;📌 Pins, checked on every call&lt;/b&gt;&lt;br&gt;&lt;i&gt;new, renamed or changed tools&#10;hidden until reviewed again&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FBE3E1;strokeColor=#D2453E;" vertex="1" parent="1"><mxGeometry x="306" y="256" width="268" height="70" as="geometry"/></mxCell><mxCell id="c11" value="listeners: default 127.0.0.1:7381 (as today); readonly on demand, token, sandboxes only" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;text;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="306" y="340" width="268" height="20" as="geometry"/></mxCell><mxCell id="c12" value="profiles" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=3;fillColor=none;strokeColor=#2F6FCF;dashed=1;strokeWidth=1.5;fontStyle=1;fontColor=#1F4E9E;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="630" y="56" width="250" height="340" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;research&lt;/b&gt;&lt;br&gt;&lt;i&gt;web, nothing private&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shadow=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="646" y="90" width="218" height="48" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;work-readonly&lt;/b&gt;&lt;br&gt;&lt;i&gt;reviewed sets, no web&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontColor=#1A1A1A;rounded=1;arcSize=6;fillColor=#EAF1FB;strokeColor=#2F6FCF;strokeWidth=1.5;shad