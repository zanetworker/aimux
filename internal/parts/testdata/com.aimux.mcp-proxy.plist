<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/someone</string>
		<key>PATH</key>
		<string>/Users/someone/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.aimux.mcp-proxy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/someone/.aimux/services/mcp-proxy/aimux</string>
		<string>mcp</string>
		<string>proxy</string>
		<string>serve</string>
		<string>--port</string>
		<string>7381</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/someone/.aimux/logs/mcp-proxy/stderr.log</string>
	<key>StandardOutPath</key>
	<string>/Users/someone/.aimux/logs/mcp-proxy/stdout.log</string>
</dict>
</plist>
