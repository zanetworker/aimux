<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.azaalouk.aimux-collect</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/someone/.aimux/services/collector/aimux</string>
        <string>collect</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/someone/.claude/logs/aimux-collect.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/someone/.claude/logs/aimux-collect.error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/someone</string>
        <key>PATH</key>
        <string>/Users/someone/go/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
